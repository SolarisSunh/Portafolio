{"data":{"id":5,"status":"publish","title":"Home","content":"<!-- wp:group {\"metadata\":{\"name\":\"Menu\",\"patternCategory\":\"menu\",\"patternSubcategory\":\"\",\"remotePatternId\":16702},\"align\":\"full\",\"className\":\"is-style-default\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull is-style-default\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\"><!-- wp:heading {\"className\":\"ai-ignore\"} -->\n<h2 class=\"wp-block-heading ai-ignore\">Menú</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Sections\"},\"align\":\"wide\"} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:group {\"metadata\":{\"name\":\"Section\"},\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignwide\"><!-- wp:heading {\"level\":3,\"className\":\"has-text-align-center is-menu-section-name\"} -->\n<h3 class=\"wp-block-heading has-text-align-center is-menu-section-name\">Menu</h3>\n<!-- /wp:heading -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Warm Chocolate Chip Cookie</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Soft classic dough with melting chips</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\",\"style\":{\"layout\":{\"selfStretch\":\"fit\",\"flexSize\":null}}} -->\n<p class=\"is-menu-item-price\">$3.00</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Oat Delight</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Chewy oats, golden raisins, hint of cinnamon</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.10</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Midnight Fudge Brownie</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Dense chocolate cookie packed with fudge chunks</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.50</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Sugar Sprinkle</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Light vanilla cookie covered in rainbow sprinkles</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$2.80</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Cinnamon Roll</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Soft swirl cookie with cinnamon sugar drizzle</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.40</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Caramel Swirl</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Buttery cookie ribboned with soft caramel</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\",\"style\":{\"layout\":{\"selfStretch\":\"fit\",\"flexSize\":null}}} -->\n<p class=\"is-menu-item-price\">$3.25</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Peanut Butter Crunch</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Rich peanut dough, crispy edges, roasted peanut pieces</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.20</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Salted Caramel Brownie</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Dark cocoa cookie, gooey caramel center</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.60</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Lemon Zest</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Bright citrus cookie topped with tangy lemon glaze</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.05</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"center\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":4,\"className\":\"has-text-align-center is-menu-item-name\"} -->\n<h4 class=\"wp-block-heading has-text-align-center is-menu-item-name\">Snickerdoodle</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-description\",\"style\":{\"typography\":{\"textAlign\":\"center\"}},\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center is-menu-item-description has-small-font-size\">Tender cookie rolled in cinnamon sugar, perfectly cozy</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-menu-item-price\"} -->\n<p class=\"is-menu-item-price\">$3.15</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:spacer {\"height\":\"20px\"} -->\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Gallery\",\"patternCategory\":\"gallery\",\"patternSubcategory\":\"\",\"remotePatternId\":13530},\"align\":\"full\",\"className\":\"is-style-section-2\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-2\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40)\"><!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column {\"width\":\"50%\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:image {\"id\":12,\"aspectRatio\":\"3/4\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://miguelalejandrochavez-zcrxp.wordpress.com/wp-content/uploads/2026/05/the-golden-crumb-6a0ab271dc1d5.png\" alt=\"An assortment of gourmet cookies arranged in a neat grid on a sheet of crisp parchment paper atop a light oak bakery counter. Each row features a different flavor: rainbow sprinkle sugar cookies, crinkled double chocolate, oatmeal raisin with visible oats, and sea-salt caramel with glossy drizzles. Soft, warm pendant lighting from above creates gentle reflections on sugary surfaces and casts delicate shadows along the parchment folds. The background fades into a creamy bokeh of shelves and jars, in photographic realism. Captured from a slightly elevated, top-down angle, the composition is clean and organized, evoking a playful yet professional cookie menu for a school project site.\" class=\"wp-image-12\" style=\"aspect-ratio:3/4;object-fit:cover\" /></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"left\",\"contentSize\":\"640px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p>Take a peek behind our counter, where trays of golden cookies cool beside jars of sprinkles, chocolate chunks, and caramel bits, ready for their close‑up and waiting to be chosen as your next sweet treat.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"50%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column {\"width\":\"50%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"50%\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:image {\"id\":9,\"aspectRatio\":\"3/4\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https://miguelalejandrochavez-zcrxp.wordpress.com/wp-content/uploads/2026/05/the-golden-crumb-6a0ab27148417.png\" alt=\"A close-up of a single signature cookie called “The Golden Crumb,” thick and slightly domed with a deep golden-brown surface, crisp edges, and a soft, crackled center revealing gooey white and dark chocolate chunks. The cookie rests on a small white ceramic plate with a subtle matte finish, placed on a light linen napkin in soft mustard and cream stripes. Gentle morning sunlight streams in from the left, creating a warm glow and a tiny highlight on scattered crumbs. The background, in photographic realism, is softly blurred with hints of a wooden table and a glass cookie jar. Shot with a tight, centered composition and shallow depth of field, the atmosphere feels cozy, special, and delightfully indulgent.\" class=\"wp-image-9\" style=\"aspect-ratio:3/4;object-fit:cover\" /></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"left\",\"contentSize\":\"640px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph -->\n<p>From gooey chocolate centers to crisp sugared edges, our cookie gallery captures each batch in all its toasty perfection, so you can almost smell the butter and vanilla through the screen.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"categories\":[\"services\"],\"name\":\"Services\",\"patternName\":\"assembler/services-3\",\"patternCategory\":\"testimonials\",\"patternSubcategory\":\"\",\"remotePatternId\":13666},\"align\":\"full\",\"className\":\"alignfull is-style-section-2\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"}}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-2\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\"><!-- wp:columns {\"metadata\":{\"name\":\"Items\"},\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"style\":{\"layout\":{\"selfStretch\":\"fixed\",\"flexSize\":\"100%\"}}} -->\n<h2 class=\"wp-block-heading\">Cookie Love<br><br>imaginary classmate reviews</h2>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:jetpack/rating-star {\"rating\":5,\"className\":\"is-style-filled\"} -->\n<figure class=\"wp-block-jetpack-rating-star is-style-filled\" style=\"text-align:left\"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></figure>\n<!-- /wp:jetpack/rating-star -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-review\"} -->\n<p class=\"is-testimonial-review\">The Golden Crumb makes the softest cookies I have ever tasted. Every bite feels homemade, and the friendly staff remember my favorite order each time I visit.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-name ai-ignore\"} -->\n<p class=\"is-testimonial-name ai-ignore\">- Axel arellano</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:jetpack/rating-star {\"rating\":4,\"className\":\"is-style-filled\"} -->\n<figure class=\"wp-block-jetpack-rating-star is-style-filled\" style=\"text-align:left\"><span>★</span><span>★</span><span>★</span><span>★</span></figure>\n<!-- /wp:jetpack/rating-star -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-review\"} -->\n<p class=\"is-testimonial-review\">I ordered a mixed dozen for a school event, and they disappeared in minutes. Beautifully packed, still warm, and every single flavor was a hit with students.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-name ai-ignore\"} -->\n<p class=\"is-testimonial-name ai-ignore\">- JUAN EMILIO MORENO REYNA</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:jetpack/rating-star {\"rating\":4,\"className\":\"is-style-filled\"} -->\n<figure class=\"wp-block-jetpack-rating-star is-style-filled\" style=\"text-align:left\"><span>★</span><span>★</span><span>★</span><span>★</span></figure>\n<!-- /wp:jetpack/rating-star -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-review\"} -->\n<p class=\"is-testimonial-review\">Their gluten‑friendly options taste just as indulgent as the classics. It is the only place where my whole family can share a cookie box without compromise.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-name ai-ignore\"} -->\n<p class=\"is-testimonial-name ai-ignore\">- Abdiel enrique villatoro barrera</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Item\"},\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:jetpack/rating-star {\"rating\":5,\"className\":\"is-style-filled\"} -->\n<figure class=\"wp-block-jetpack-rating-star is-style-filled\" style=\"text-align:left\"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></figure>\n<!-- /wp:jetpack/rating-star -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-review\"} -->\n<p class=\"is-testimonial-review\">Stopping in for a warm cookie and a milk is my favorite study break. The cozy smell and soft music make it hard to leave again.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"is-testimonial-name ai-ignore\"} -->\n<p class=\"is-testimonial-name ai-ignore\">- Henry santiago ramirez rodriguez</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"About\",\"patternCategory\":\"general\",\"patternSubcategory\":\"\",\"remotePatternId\":\"13373-general\"},\"align\":\"full\",\"className\":\"alignfull is-style-default\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull is-style-default\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40)\"><!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|40\"}}}} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column {\"verticalAlignment\":\"center\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"580px\",\"justifyContent\":\"left\"}} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our Story</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>this is for my iai</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Learn more</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"bottom\"} -->\n<div class=\"wp-block-column is-vertically-aligned-bottom\"><!-- wp:image {\"lightbox\":{\"enabled\":false},\"id\":10,\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"ai-bind-avatar\"} -->\n<figure class=\"wp-block-image size-full ai-bind-avatar\"><img src=\"https://miguelalejandrochavez-zcrxp.wordpress.com/wp-content/uploads/2026/05/the-golden-crumb-6a0ab271cadc4.png\" alt=\"An inviting bakery display case filled with neatly arranged trays of cookies, viewed from the customer side with no people visible. Inside the glass, rows of perfectly aligned cookies glisten: chocolate chunk, colorful M&amp;M-studded, powdered sugar crinkles, and jam-filled thumbprints, each tray labeled with tiny handwritten-style tags. Warm, amber-toned overhead lights reflect softly on the glass surface, creating a gentle sparkle. The countertop is a smooth, light marble that adds a clean, modern contrast to the rustic wooden shelves in the softly blurred background. Captured in photographic realism from a slightly low, angled perspective to emphasize abundance, the mood is playful, cozy, and full of temptation, ideal for a cookie shop “Our Selection” section.\" class=\"wp-image-10\" style=\"aspect-ratio:1;object-fit:cover\" /></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Contact\",\"patternCategory\":\"contact\",\"patternSubcategory\":\"\",\"remotePatternId\":13484},\"align\":\"full\",\"className\":\"alignfull is-style-default\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|40\"},\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignfull is-style-default\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--40)\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"className\":\"has-text-align-center\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Visit Us</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-contact-phone-email ai-bind-phone-email\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center is-contact-phone-email ai-bind-phone-email\">I LOVE COOKIES </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>DR MIER 1394</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:social-links {\"className\":\"is-style-logos-only ai-bind-social-links\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<ul class=\"wp-block-social-links is-style-logos-only ai-bind-social-links\"><!-- wp:social-link {\"url\":\"#\",\"service\":\"facebook\"} /-->\n\n<!-- wp:social-link {\"url\":\"#\",\"service\":\"instagram\"} /--></ul>\n<!-- /wp:social-links -