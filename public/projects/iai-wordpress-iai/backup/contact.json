  "content": "\n<div class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--20)\">\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-69bbf988 wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/\">Home</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/about/\">About the Project</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--2\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/contact/\">Contact</a></div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignfull has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"padding-top:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--30)\">\n<h1 class=\"wp-block-heading has-text-align-center\">Contact us</h1>\n\n\n\n<p class=\"has-text-align-center wp-block-paragraph\">Have a question about our cookies, a custom dozen for an event, or feedback on this IAI website project? Send us a message — we would love to hear from you.</p>\n</div>\n\n\n\n<div class=\"wp-block-columns alignwide is-layout-flex wp-container-core-columns-is-layout-4b1e6bf8 wp-block-columns-is-layout-flex\" style=\"margin-bottom:var(--wp--preset--spacing--40)\">\n<div class=\"wp-block-column is-vertically-aligned-top is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:42%\">\n<h3 class=\"wp-block-heading\">Get in touch</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Email, call, or visit our bakery window at Dr Mier 1394.</p>\n\n\n\n<div class=\"wp-block-jetpack-contact-info\">\n<div class=\"wp-block-jetpack-email\"><a href=\"mailto:hello@thegoldencrumb.example\">hello@thegoldencrumb.example</a></div>\n\n\n\n<div class=\"wp-block-jetpack-phone\"><a href=\"tel:+528100000000\">+52 81 0000 0000</a></div>\n\n\n\n</div>\n\n</div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-top is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:58%\">\n<div class=\"wp-block-group has-theme-1-background-color has-background has-global-padding is-layout-constrained wp-container-core-group-is-layout-0358ffa0 wp-block-group-is-layout-constrained\" style=\"border-width:1px;border-radius:12px;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40)\">\n<h3 class=\"wp-block-heading\">Send a message</h3>\n\n\n<div class=\"wp-block-jetpack-contact-form is-layout-flex wp-container-jetpack-contact-form-is-layout-1a653187 wp-block-jetpack-contact-form-is-layout-flex\"><a href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/contact/\" target=\"_blank\" rel=\"noopener noreferrer\">Submit a form.</a></div>\n</div>\n\n</div>\n\n</div>\n\n\n\n<figure class=\"wp-block-image alignwide size-large\"><img src=\"https://miguelalejandrochavez-zcrxp.wordpress.com/wp-content/uploads/2026/05/the-golden-crumb-6a0ab271dc1d5.png\" alt=\"Assorted gourmet cookies on parchment at The Golden Crumb\" /></figure>\n\n\n\n<div class=\"wp-block-group alignwide has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\" style=\"margin-top:var(--wp--preset--spacing--50);padding-top:var(--wp--preset--spacing--40)\">\n<p class=\"has-text-align-center wp-block-paragraph\"><strong>Explore our site</strong></p>\n\n\n\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-69bbf988 wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/\">Home</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--3\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/about/\">About the Project</a></div>\n\n\n\n<div class=\"wp-block-button is-style-outline is-style-outline--4\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://miguelalejandrochavez-zcrxp.wordpress.com/contact/\">Contact</a></div>\n</div>\n</div>\n\n\n",
